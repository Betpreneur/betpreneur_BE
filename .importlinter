# Boundary contracts for the modular monolith.
#
# These are what stop the tree decaying back into folders. CI runs
# `lint-imports`; a new cross-boundary import fails the build.
#
# Run:  .venv/bin/lint-imports        (or: make verify-imports)

[importlinter]
root_packages =
    betpreneur
include_external_packages = True

# ---------------------------------------------------------------- R3
# Calls go DOWN. A module may import only from layers beneath it.
# Modules on the same line are peers and may not import each other.
#
# slips sits ABOVE picks rather than beside it: the Match Checker shows our
# analysis of each leg's fixture, which is picks' output. The dependency is
# one-directional — picks references nothing in slips — so this is a layer,
# not a cycle.
[importlinter:contract:layers]
name = R3 · modules obey the layer order
type = layers
layers =
    betpreneur.modules.settlement | betpreneur.modules.analytics
    betpreneur.modules.slips
    betpreneur.modules.picks
    betpreneur.modules.pricing | betpreneur.modules.explanations
    betpreneur.modules.scoring
    betpreneur.modules.catalog | betpreneur.modules.billing
    betpreneur.modules.markets | betpreneur.modules.identity
    betpreneur.integrations
    betpreneur.platform
exhaustive = False

# ---------------------------------------------------------------- R2
# A module's internals are private. Everything outside it imports only its
# api.py (plus contracts.py / events.py). One contract per module, so a
# module can still reach its own internals freely.
#
# allow_indirect_imports=True: api.py legitimately re-exports from its own
# internals, and that chain must not count as a violation for its consumers.

[importlinter:contract:private-markets]
name = R2 · only markets.api / .contracts / .events cross the boundary
type = forbidden
source_modules =
    betpreneur.modules.identity
    betpreneur.modules.catalog
    betpreneur.modules.billing
    betpreneur.modules.scoring
    betpreneur.modules.pricing
    betpreneur.modules.explanations
    betpreneur.modules.picks
    betpreneur.modules.slips
    betpreneur.modules.settlement
    betpreneur.modules.analytics
forbidden_modules =
    betpreneur.modules.markets.models
    betpreneur.modules.markets.services
    betpreneur.modules.markets.domain
    betpreneur.modules.markets.interface
    betpreneur.modules.markets.tasks
    betpreneur.modules.markets.handlers
    betpreneur.modules.markets.evaluators
allow_indirect_imports = True

