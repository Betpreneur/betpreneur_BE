# ---------------------------------------------------------------- R5
# domain/ is pure python. No ORM, no settings, no framework at all —
# this is what makes those tests run in milliseconds.
[importlinter:contract:domain-purity]
name = R5 · domain/ imports no framework
type = forbidden
source_modules =
    betpreneur.modules.catalog.domain
    betpreneur.modules.explanations.domain
    betpreneur.modules.identity.domain
    betpreneur.modules.markets.domain
    betpreneur.modules.pricing.domain
    betpreneur.modules.scoring.domain
    betpreneur.modules.slips.domain
forbidden_modules =
    django
    rest_framework
    celery
    redis

# ---------------------------------------------------------------- R7
# Integrations are leaves: they speak HTTP and return DTOs. They take an
# explicit config object rather than reading django.conf.settings, which is
# what lets every one of them be constructed in a test without a Django setup.
[importlinter:contract:integrations-are-leaves]
name = R7 · integrations know nothing about the domain
type = forbidden
source_modules =
    betpreneur.integrations
forbidden_modules =
    betpreneur.modules
    django

# ---------------------------------------------------------------- R1
# platform/ is the bottom. It knows no domain and no vendor.
[importlinter:contract:platform-is-bottom]
name = R1 · platform depends on nothing of ours
type = forbidden
source_modules =
    betpreneur.platform
forbidden_modules =
    betpreneur.modules
    betpreneur.integrations
