# ================================================================
# Betpreneur Backend - Docker Environment Variables
# ================================================================
# Copy this file to .env and update values
# cp .env.docker.example .env
# ================================================================

# ------------------------------
# Django
# ------------------------------
DJANGO_SECRET_KEY=change-me-in-production-use-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=backend.betpreneur.ng,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings
CSRF_TRUSTED_ORIGINS=https://backend.betpreneur.ng,https://betpreneur.ng,https://www.betpreneur.ng

# ------------------------------
# Database
# ------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=betpreneur
DB_USER=betpreneur
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ------------------------------
# External APIs
# ------------------------------
# API-Football
APS_KEY=
APS_MAX_FIXTURES=90

# Gemini analyst mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek pick explanation writer
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Leave blank to enable LLM reasoning automatically when DEEPSEEK_API_KEY is set.
ALGO_LLM_REASONING_ENABLED=
ALGO_LLM_DEBUG_LOG_RESPONSE=False

# Resend (email delivery)
RESEND_API_KEY=
RESEND_FROM_NAME=Betpreneur
RESEND_FROM_EMAIL_PREFIX=support
RESEND_FROM_EMAIL_DOMAIN=betpreneur.ng
RESEND_FROM_EMAIL=support@betpreneur.ng

# ------------------------------
# Google Drive Integration
# ------------------------------
KEY_FILE=
SHEET_NAME=GrindAlgo Tracker
DRIVE_FOLDER=GrindAlgo Reports
EMAIL_RECIPIENT=
GMAIL_APP_PASSWORD=

# ------------------------------
# Celery Automation
# ------------------------------
CELERY_BROKER_URL=redis://default:change-me@your-coolify-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:change-me@your-coolify-redis-host:6379/0
ALGO_GENERATE_HOUR=0
ALGO_GENERATE_MINUTE=5
ALGO_SETTLE_HOUR=6
ALGO_SETTLE_MINUTE=30
ALGO_AUDITOR_DAY=1
ALGO_AUDITOR_HOUR=8
ALGO_AUDITOR_MINUTE=0
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_QUEUES=celery
CELERY_MAX_TASKS_PER_CHILD=1
ALGO_SCORING_RATE_LIMIT=6/m
ALGO_SCORING_SOFT_TIME_LIMIT=900
ALGO_SCORING_TIME_LIMIT=1200
ALGO_LLM_RATE_LIMIT=12/m
ALGO_LLM_SOFT_TIME_LIMIT=300
ALGO_LLM_TIME_LIMIT=420
ALGO_LLM_BATCH_SIZE=2
ALGO_MIN_EV=0.02
ALGO_MIN_MARKET_SAMPLE=15
ALGO_PERFORMANCE_PROFILE_DAYS=90
ALGO_PERFORMANCE_MAX_RECORDS=20000
ALGO_MEMORY_DEBUG=True
ALGO_MAX_DAILY_PICKS=15
ALGO_REQUIRE_REAL_ODDS=False
ALGO_ALLOW_ESTIMATED_PICKS=False
ALGO_CORNER_MIN_CONFIDENCE=68
ALGO_ENABLE_CORNERS=True
ALGO_CORNER_MIN_LINE=7.5
ALGO_CORNER_MAX_ODDS=3.5
ALGO_CORNER_MIN_PROFILE_GAMES=6

# ------------------------------
# Application
# ------------------------------
FRONTEND_URL=https://betpreneur.ng,https://www.betpreneur.ng,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://betpreneur.ng,https://www.betpreneur.ng,http://localhost:3000
TZ=Africa/Lagos
WEB_CONCURRENCY=2
WEB_THREADS=2
GUNICORN_TIMEOUT=120
ENABLE_WEBSOCKETS=true
SLIP_REVIEW_PARALLEL_LEG_THRESHOLD=4
SLIP_REVIEW_ANALYSIS_WORKERS=4
SLIP_REVIEW_LEG_CACHE_TTL_SECONDS=900
SLIP_REVIEW_LEG_CACHE_LOCK_SECONDS=300
SLIP_REVIEW_LEG_CACHE_WAIT_SECONDS=45
SLIP_REVIEW_STALE_AFTER_SECONDS=1200
SLIP_REVIEW_RECOVERY_MINUTES=*/5
SLIP_REVIEW_RECOVERY_LIMIT=25
SLIP_REVIEW_DEEPSEEK_MAX_GAMES=5
SLIP_REVIEW_STREAM_TICKET_SECONDS=1800
SLIP_REVIEW_QUEUE=slip_review
SLIP_REVIEW_WORKER_CONCURRENCY=4
SLIP_REVIEW_MAX_TASKS_PER_CHILD=20
